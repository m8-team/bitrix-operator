{
  "uid": "bitrix-operator",
  "title": "Bitrix Operator",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "bitrix",
    "kubernetes"
  ],
  "editable": true,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "kubernetes_cluster",
        "label": "kubernetes_cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bitrix_cluster_generation, kubernetes_cluster)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster_namespace",
        "label": "cluster_namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bitrix_cluster_generation{kubernetes_cluster=~\"$kubernetes_cluster\"}, cluster_namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(bitrix_cluster_generation{kubernetes_cluster=~\"$kubernetes_cluster\",cluster_namespace=~\"$cluster_namespace\"}, cluster)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Ready: 1 = current Ready, 0 = false / unknown / stale",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kubernetes_cluster, cluster_namespace, cluster) (bitrix_cluster_condition{kubernetes_cluster=~\"$kubernetes_cluster\",cluster_namespace=~\"$cluster_namespace\",cluster=~\"$cluster\",condition=\"Ready\",status=\"True\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Unobserved generations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kubernetes_cluster, cluster_namespace, cluster) (bitrix_cluster_generation{kubernetes_cluster=~\"$kubernetes_cluster\",cluster_namespace=~\"$cluster_namespace\",cluster=~\"$cluster\"}) - max by (kubernetes_cluster, cluster_namespace, cluster) (bitrix_cluster_observed_generation{kubernetes_cluster=~\"$kubernetes_cluster\",cluster_namespace=~\"$cluster_namespace\",cluster=~\"$cluster\"})",
          "legendFormat": "{{kubernetes_cluster}} / {{cluster_namespace}} / {{cluster}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Workload replicas: last persisted observation",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (kubernetes_cluster, cluster_namespace, cluster, component, state) (bitrix_cluster_replicas{kubernetes_cluster=~\"$kubernetes_cluster\",cluster_namespace=~\"$cluster_namespace\",cluster=~\"$cluster\",state=~\"desired|available\"})",
          "legendFormat": "{{kubernetes_cluster}} / {{cluster_namespace}} / {{cluster}} / {{component}} / {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Collector success: manager instances (0 = cache read failed)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bitrix_operator_collection_success{kubernetes_cluster=~\"$kubernetes_cluster\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Reconcile errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(controller_runtime_reconcile_errors_total{controller=\"bitrixcluster\",kubernetes_cluster=~\"$kubernetes_cluster\"}[5m])",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
