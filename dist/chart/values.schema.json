{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "manager": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "healthProbe"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\S+$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "healthProbe": {
          "type": "object",
          "required": [
            "port"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imagePullSecrets": {
          "type": "array"
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "namespaced": {
          "enum": [
            false
          ]
        },
        "helpers": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secure": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  }
}
