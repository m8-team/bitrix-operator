; Runtime contract v1. Load after the image's extension INI files.
short_open_tag = On
memory_limit = 512M
upload_max_filesize = 1024M
post_max_size = 1024M
max_execution_time = 300
max_input_vars = 10000
expose_php = Off
display_errors = Off
log_errors = On
zend.exception_ignore_args = On
cgi.fix_pathinfo = 0
session.name = BITRIX_PHPSESSID
session.cookie_httponly = 1
session.cookie_samesite = Lax
session.use_strict_mode = 1
opcache.validate_timestamps = 0
upload_tmp_dir = {{ .TemporaryPath | iniPath }}
sys_temp_dir = {{ .TemporaryPath | iniPath }}
