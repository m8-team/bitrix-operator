worker_processes auto;
worker_shutdown_timeout 300s;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
 include /etc/nginx/mime.types;
 default_type application/octet-stream;
 server_names_hash_bucket_size 512;
 map_hash_bucket_size 512;
 access_log /dev/stdout;
 server_tokens off;
 client_body_temp_path /tmp/client-body;
 fastcgi_temp_path /tmp/fastcgi;
 proxy_temp_path /tmp/proxy;
 uwsgi_temp_path /tmp/uwsgi;
 scgi_temp_path /tmp/scgi;
 client_max_body_size 1024m;
 sendfile on;
{{ if .PushEnabled }}
 include /tmp/push-resolver.conf;
 upstream bitrix_push_sub { zone bitrix_push_sub 64k; server {{ .PushSubscriber }}.@SEARCH@:8010 resolve; }
 upstream bitrix_push_pub { zone bitrix_push_pub 64k; server {{ .PushPublisher }}.@SEARCH@:9010 resolve; }
 map $http_upgrade $push_connection { default upgrade; '' close; }
{{ end }}
 server {
  listen 8081;
  server_name _;
  access_log off;
  location = /live { return 200 'ok'; }
  location = /ready {
   if (-f /tmp/draining) { return 503; }
   include /etc/nginx/fastcgi_params;
   fastcgi_param SCRIPT_FILENAME /run/bitrix-config/ready.php;
   fastcgi_pass 127.0.0.1:9000;
   fastcgi_read_timeout 7s;
  }
  location / { return 404; }
 }
 # Host mapping is generated from validated CR data, never from a client header.
 map $host $operator_site_id {
  default "";
{{ range .Sites }}{{ $id := .ID }}{{ range .Hosts }}  {{ . }} "{{ $id }}";
{{ end }}{{ end }} }
 # Publication scheme is operator configuration, never a client-supplied proxy header.
 map $host $operator_https {
  default "";
{{ range .Sites }}{{ if and $.GatewayEnabled .TLS }}{{ range .Hosts }}  {{ . }} on;
{{ end }}{{ end }}{{ end }} }
 map $operator_https $operator_scheme { default http; on https; }
 map $operator_https $operator_port {
  default {{ if .PublicationPort }}{{ .PublicationPort }}{{ else }}80{{ end }};
  on {{ if .PublicationPort }}{{ .PublicationPort }}{{ else }}443{{ end }};
 }
 server { listen 8080 default_server; server_name _; return 444; }
 server {
  listen 8080;
  server_name {{ .Hosts | nginxHosts }};
  root /opt/www;
  index index.php;
  location = /_operator/health { access_log off; return 200 'ok'; }
  location ~ /\. { deny all; }
  location ~* ^/(?:bitrix|local)/(?:php_interface|modules)/ { deny all; }
  location ~* ^/bitrix/(?:license_key\.php|backup(?:/|$)|updates(?:/|$)) { deny all; }
  location ~* ^{{ .UploadsPath | nginxUploadsPattern }}/.*\.(?:php[0-9]*|phtml|phar)(?:/|$) { deny all; }
  location ~* \.(?:bak|sql|log|ini|conf|sh|dist)$ { deny all; }
  # Never expose the trusted backend publication API or server statistics.
  location ~* ^/bitrix/pub(?:/|$) { return 403; }
  location ~* ^/server-stat(?:/|$) { return 403; }
{{ if .PushEnabled }}
  location = /bitrix/subws/ {
   access_log off;
   proxy_pass http://bitrix_push_sub;
   proxy_http_version 1.1;
   proxy_set_header Upgrade $http_upgrade;
   proxy_set_header Connection $push_connection;
   proxy_buffering off;
   proxy_read_timeout 75s;
  }
  location = /bitrix/sub/ {
   access_log off;
   proxy_pass http://bitrix_push_sub/bitrix/subws/;
   proxy_buffering off;
   proxy_read_timeout 75s;
  }
  location = /bitrix/rest/ {
   access_log off;
   client_max_body_size 1m;
   proxy_pass http://bitrix_push_pub;
   proxy_read_timeout 25s;
  }
{{ end }}
  location / { try_files $uri $uri/ /bitrix/urlrewrite.php?$query_string; }
  location ~ \.php$ {
   try_files $uri =404;
   fastcgi_pass 127.0.0.1:9000;
   fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
   fastcgi_param QUERY_STRING $query_string;
   fastcgi_param REQUEST_METHOD $request_method;
   fastcgi_param CONTENT_TYPE $content_type;
   fastcgi_param CONTENT_LENGTH $content_length;
   fastcgi_param SCRIPT_NAME $fastcgi_script_name;
   fastcgi_param REQUEST_URI $request_uri;
   fastcgi_param DOCUMENT_URI $document_uri;
   fastcgi_param DOCUMENT_ROOT $document_root;
   fastcgi_param SERVER_PROTOCOL $server_protocol;
   fastcgi_param REQUEST_SCHEME $operator_scheme;
   fastcgi_param HTTPS $operator_https if_not_empty;
   fastcgi_param GATEWAY_INTERFACE CGI/1.1;
   fastcgi_param SERVER_SOFTWARE nginx;
   fastcgi_param REMOTE_ADDR $remote_addr;
   fastcgi_param REMOTE_PORT $remote_port;
   fastcgi_param SERVER_ADDR $server_addr;
   fastcgi_param SERVER_PORT $operator_port;
   fastcgi_param SERVER_NAME $host;
   fastcgi_param BITRIX_SITE_ID $operator_site_id;
   fastcgi_param HTTP_PROXY "";
   fastcgi_param REDIRECT_STATUS 200;
   fastcgi_read_timeout 300s;
  }
  location ~* \.(?:php[0-9]*|phtml|phar)(?:[^a-z0-9]|$) { deny all; }
 }
}
